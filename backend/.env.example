# Agent 1 — resume analyst.
ANTHROPIC_API_KEY=sk-ant-...

# Agent 2 — job scout. Reasoning runs on DeepSeek; the vision model is only
# used as a fallback for pages the DOM path cannot parse.
OPENROUTER_API_KEY=sk-or-...
SCOUT_MODEL=deepseek/deepseek-v4-flash
SCOUT_VISION_MODEL=google/gemini-3.7-flash

# How LinkedIn roles reach the search, without touching linkedin.com.
# LinkedIn syndicates its postings to Google for Jobs deliberately; JSearch
# reads that aggregation. Free tier is 200 requests/month (a request returns a
# page of jobs, not one job) — sign up at openwebninja.com/api/jsearch
JSEARCH_API_KEY=
JSEARCH_COUNTRY=sa

# Defaults to SQLite so the app runs with no external services.
# For production: postgresql+psycopg://user:pass@localhost:5432/jobhunt
DATABASE_URL=sqlite:///./jobhunt.db
