# Both agents — the resume analyst and the job scout — run on Gemini Flash,
# with this one key. Get one at https://aistudio.google.com/apikey
#
# Turn on billing for the key's Google Cloud project before uploading real CVs.
# On the free tier Google may use what you send (your CV) to improve its
# products, and human reviewers may read it; on the paid tier it does not.
GEMINI_API_KEY=
# gemini-3.8-flash is newer, but was overloaded (503) when this was set up.
GEMINI_MODEL=gemini-3.6-flash
# low | medium | high. Lower is cheaper and faster, and reasons less carefully.
GEMINI_THINKING=high

# How LinkedIn roles reach the search, without touching linkedin.com.
# LinkedIn syndicates its postings to Google for Jobs deliberately; JSearch
# reads that aggregation. Free tier is 200 requests/month (a request returns a
# page of jobs, not one job) — sign up at openwebninja.com/api/jsearch
JSEARCH_API_KEY=
JSEARCH_COUNTRY=sa

# Defaults to SQLite so the app runs with no external services.
# For production: postgresql+psycopg://user:pass@localhost:5432/jobhunt
DATABASE_URL=sqlite:///./jobhunt.db
